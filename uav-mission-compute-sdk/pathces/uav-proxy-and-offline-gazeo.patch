 # SPDX-License-Identifier: Apache-2.0
 
 SHELL := bash -eu -o pipefail
-.PHONY: init up-sim-camera up-sim-camera-lean up-sim-camera-mono up-sim-camera-mono-lean up-usb-camera-lean up-realsense-camera up-realsense-camera-lean up-ethernet down down-ethernet build build-nc logs ps stats apps apps-down apps-logs clean clean-all deps clean-venv bench bench-client-sweep bench-bridge-sweep bench-all help
+.PHONY: init up-sim-camera up-sim-camera-lean up-sim-camera-offline up-sim-camera-mono up-sim-camera-mono-lean up-usb-camera-lean up-realsense-camera up-realsense-camera-lean up-ethernet down down-ethernet build build-nc logs ps stats apps apps-down apps-logs clean clean-all deps clean-venv bench bench-client-sweep bench-bridge-sweep bench-all help
 
 # ── Deployment mode flag ───────────────────────────────────────────────────
 # FC_IP must be set for ethernet mode (IP of FC machine running mavlink-router)
 FC_IP ?=
 
+# The PX4 image is built from packages on repositories.intel.com, which is on the public internet. A corporate NO_PROXY
+# that lists intel.com would make apt and wget connect directly and hang for many minutes, so the build gets a no_proxy
+# without intel.com entries.
+export PX4_BUILD_NO_PROXY := $(shell printf '%s' "$$NO_PROXY" | tr ',' '\n' | grep -viE '^[.]?([a-z0-9-]+[.])*intel[.]com$$' | paste -sd, -)
+
 COMPOSE_LOCAL   := docker compose -f docker-compose.yml
 COMPOSE_ETH     := docker compose -f docker-compose.yml -f docker-compose.ethernet.yml
 COMPOSE_APPS    := docker compose --env-file .env -f sample-apps/docker-compose.yml
@@ -74,6 +79,8 @@ init:
 # var on every run, so switching between multi-cam and mono-cam is clean
 # regardless of what a previous `make up-sim-camera*` run left behind.
 SIM_CAMERA_VARS_MULTI = PX4_START_SCRIPT=start_px4_multicam.sh PX4_MODEL_DIR=multi_cam PX4_WORLD_FILE=baylands_multicam.sdf GZ_WORLD=baylands_multicam CAMERA_IDS=nadir,forward,rear VISION_CAMERA_IDS=nadir,forward,rear COMPANION_BRIDGE_URL=http://px4-gazebo:8080
+# Same cameras in a self-contained world (no model downloads from fuel.gazebosim.org); for hosts without internet access
+SIM_CAMERA_VARS_OFFLINE = PX4_START_SCRIPT=start_px4_multicam.sh PX4_MODEL_DIR=multi_cam PX4_WORLD_FILE=detection_zone.sdf GZ_WORLD=detection_zone CAMERA_IDS=nadir,forward,rear VISION_CAMERA_IDS=nadir,forward,rear COMPANION_BRIDGE_URL=http://px4-gazebo:8080
 SIM_CAMERA_VARS_MONO = PX4_START_SCRIPT=start_px4.sh PX4_MODEL_DIR=mono_cam PX4_WORLD_FILE=baylands_detection.sdf GZ_WORLD=baylands_detection CAMERA_IDS=nadir VISION_CAMERA_IDS=nadir COMPANION_BRIDGE_URL=http://px4-gazebo:8080
 
 define set_env_vars
@@ -95,6 +102,11 @@ up-sim-camera-lean:
 	$(call set_env_vars,$(SIM_CAMERA_VARS_MULTI))
