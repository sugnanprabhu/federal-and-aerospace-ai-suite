+up-sim-camera-offline:
+	@# Help: Start the 3-camera sim in the self-contained detection_zone world (no Gazebo Fuel downloads; no observability stack)
+	$(call set_env_vars,$(SIM_CAMERA_VARS_OFFLINE))
+	PX4_NETWORK_SERVICE=px4 $(COMPOSE_LOCAL) --profile sim-camera up -d --build
+
 up-sim-camera-mono:
 	@# Help: Start core infra with PX4 Gazebo sim cameras — 1 camera: nadir only (sim-camera profile)
 	$(call set_env_vars,$(SIM_CAMERA_VARS_MONO))
