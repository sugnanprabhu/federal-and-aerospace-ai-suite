<sdf version='1.9'>
  <!-- Cameras kept level by gimbal_stabilizer.py, which moves this static model to the drone
       position with only the drone heading (no roll/pitch). camera_link carries the same
       Ry(90 deg) as the drone's camera_link so the sensor poses match multi_cam. -->
  <model name='stab_cams_0'>
    <static>true</static>
    <link name="camera_link">
      <pose>0 0 0 0 1.5707 0</pose>
      <sensor name="imager_nadir" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0 0 0 0 -0.5236 0</pose>
        <camera>
          <horizontal_fov>1.3</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>

      <!-- Forward camera sensor: 45 deg forward-down relative to nadir -->
      <sensor name="imager_forward" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0.05 0 0.03 0 -0.7854 0</pose>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>

      <!-- Rear camera sensor: 45 deg rear-down, offset behind the rear rotors so the airframe is not in view -->
      <sensor name="imager_rear" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>-0.75 0 -0.1 0 0.7854 0</pose>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
  </model>
</sdf>
