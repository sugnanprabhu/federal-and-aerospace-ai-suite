      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Rescue Randy</uri>
      <name>person_2</name>
      <static>true</static>
      <pose>10 -8 0 0 0 0</pose>
    </include>

    <!-- Another hatchback — 12m west, 5m north, rotated 2.0 rad -->
