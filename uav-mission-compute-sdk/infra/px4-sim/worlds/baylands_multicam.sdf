<!--
  baylands_multicam — Baylands terrain + expanded set of COCO-detectable objects.
  Includes vehicles, pedestrians, street furniture for multi-camera demo.
  Placed within 30m of home so the uav sees them during circuit.
-->
<sdf version='1.9'>
  <world name='baylands_multicam'>

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.412173071650805</latitude_deg>
      <longitude_deg>-121.998878727967</longitude_deg>
      <elevation>38</elevation>
    </spherical_coordinates>

    <scene>
      <ambient>0.8 0.5 1</ambient>
      <grid>false</grid>
      <sky>
        <clouds>true</clouds>
      </sky>
      <shadows>0</shadows>
    </scene>

    <light name='sunUTC' type='directional'>
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0 0 -1</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <!-- Baylands terrain mesh without trees (generated in the image by make_baylands_notrees.py) -->
    <include>
      <uri>model://baylands_notrees</uri>
      <name>park</name>
      <!-- Offset so the spawn point (world origin) sits on a flat, grass-only patch
           of the terrain (no road/parking markings, no water, no holes) with the
           ground just below z=0 so the vehicles and people stand on it -->
      <pose>-65 55 -0.3 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Coast Water</uri>
      <pose>0 0 -2 0 0 0
        <relative_to>park</relative_to>
      </pose>
    </include>

    <!-- ══════════════════════════════════════════════════════════════════
         Detectable objects — textured Fuel models that YOLO recognizes
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Hatchback car — 8m north -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback</uri>
      <name>car_1</name>
      <static>true</static>
      <pose>8 0 0 0 0 0.3</pose>
    </include>

    <!-- SUV — 6m east -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/SUV</uri>
      <name>car_2</name>
      <static>true</static>
      <pose>0 8 0 0 0 -0.5</pose>
    </include>

    <!-- Pickup truck — 12m southwest -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pickup</uri>
      <name>truck_1</name>
      <static>true</static>
      <pose>-10 -7 0 0 0 1.2</pose>
    </include>

    <!-- Hatchback red — 15m north-east -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback red</uri>
      <name>car_3</name>
      <static>true</static>
      <pose>12 10 0 0 0 -1.0</pose>
    </include>

    <!-- Construction cone — scattered -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <name>cone_1</name>
      <static>true</static>
      <pose>5 3 0 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <name>cone_2</name>
      <static>true</static>
      <pose>-3 8 0 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <name>cone_3</name>
      <static>true</static>
      <pose>-8 -3 0 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Barrel</uri>
      <name>barrel_1</name>
      <static>true</static>
      <pose>15 -5 0 0 0 0</pose>
    </include>

    <!-- Person standing -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Rescue Randy</uri>
      <name>person_1</name>
      <static>true</static>
      <pose>-5 12 0 0 0 0</pose>
    </include>

    <!-- ══════════════════════════════════════════════════════════════════
         Additional objects for multi-camera demo
         ══════════════════════════════════════════════════════════════════ -->

